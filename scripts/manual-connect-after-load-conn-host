#!/usr/bin/env bash
set -euo pipefail

addr="${1:-00:04:63:BA:64:FC}"
out="/tmp/manual-connect-after-load-conn-$(date +%s).out"

sudo -v
uv run python -m bosch_ble.trace_connect --precheck
read -r -p "Host ready. Turn on the bike, open Bluetooth pairing, then press Enter: " ready
echo "OUT:${out}"
uv run python -m bosch_ble.trace_connect "${addr}" | tee "${out}"
